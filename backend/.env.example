NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://fip_user:change_me@localhost:15433/fip_core?schema=public
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
ADMIN_NAME=FIP Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
REDE_BASE_URL=https://api.userede.com.br
REDE_CLIENT_ID=
REDE_CLIENT_SECRET=
REDE_MERCHANT_ID=
REDE_PV=
REDE_ENVIRONMENT=sandbox
REDE_TIMEOUT_MS=30000
REDE_USE_MOCKS=true
REDE_TRANSACTIONS_ENDPOINT=/transactions
REDE_RECEIVABLES_ENDPOINT=/receivables

JOBS_ENABLED=true
JOB_IMPORT_REDE_TRANSACTIONS_ENABLED=true
JOB_IMPORT_REDE_TRANSACTIONS_CRON=0 6 * * *
JOB_IMPORT_REDE_RECEIVABLES_ENABLED=true
JOB_IMPORT_REDE_RECEIVABLES_CRON=30 6 * * *
JOB_RECONCILIATION_ENABLED=true
JOB_RECONCILIATION_CRON=0 7 * * *
JOB_DEFAULT_LOOKBACK_DAYS=3
JOB_CLEANUP_OLD_LOGS_ENABLED=false
JOB_CLEANUP_OLD_LOGS_CRON=0 3 * * 0
JOB_LOG_RETENTION_DAYS=90
